import json
import subprocess
import time
from multiprocessing import Pool

def api_call(data):
    # Initialize curl command to call the Flask API
    curl_command = f'curl -X POST "http://localhost:5000/predict" -H "Content-Type: application/json" -d "{json.dumps([data])}"'

    # Call curl and store the result as json value
    result = json.loads(subprocess.check_output(curl_command, shell=True))

    # Measure the total time taken to complete the API call
    time_taken = time.time() - start_time

    return result, time_taken

start_time = time.time()

num_trials = 1000  # Number of trials to run
data = [[0, 1, 1, 0, 1, 0, 0, 0, 0, 0]]  # Input data for the model

# Use a Pool to make multiple concurrent API calls
with Pool(processes=10) as pool:
    results, times = zip(*pool.map(api_call, [data] * num_trials))

# Calculate the average time taken per API call
average_time_taken = sum(times) / len(times)

print(f'Average time taken per API call: {average_time_taken} seconds')
```

Replace `'http://localhost:5000/predict'` with the path to your Flask API.

Save the file and run the script:

```bash
python benchmark.py
```

