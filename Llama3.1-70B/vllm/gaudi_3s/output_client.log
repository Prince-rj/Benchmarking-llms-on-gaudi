from tokenizers import Tokenizer

# Load pre-trained model and tokenizer
model = AutoModelForSeq2SeqLM.from_pretrained('t5-base')
tokenizer = AutoTokenizer.from_pretrained('t5-base')

# Define a custom input format
class ConversationInput:
    def __init__(self, prompt, history):
        self.prompt = prompt
        self.history = history

    def tokenize(self, tokenizer):
        prompt_tokens = tokenizer.encode(self.prompt, return_tensors='pt')
        history_tokens = tokenizer.encode(self.history, return_tensors='pt', truncation=True, max_length=512)
        return {'prompt': prompt_tokens, 'history': history_tokens}

# Create a sample conversation input
