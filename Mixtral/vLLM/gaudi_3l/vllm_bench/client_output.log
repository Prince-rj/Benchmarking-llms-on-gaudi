```python
import sys
import torch

# Hack for library compatibility
sys.path.append('..')
torch._C._jit_set_python_debug_mode(False)  # Set before importing vllm.
```

### Import the models


```python
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM
from vllm import ModelConfig, Model
import vex.torch as vt  # Use `vex.torch` imported from `vex/torch_patches.py` as `vt`.
```

### Tokenize input


```python
tokenizer = AutoTokenizer.from_pretrained('t5-small')
input_ids = torch.tensor(
    tokenizer.encode('translate English to French: I love cheese.'),
    dtype=torch.long,
)
input_batch = vt.TensorDict({'input_ids': input_ids})
```

### Model serving


```python
# Model configuration in `ModelConfig`.
config = ModelConfig(
    name='t5-small',
    type='seq2seq',
    lora_rank=0,
    max_seq_len=256,
    max_batch_size=1,
    device=torch.device('cpu'),
    logits_mode='box_voting',
)  # Lora is not used in this example so no need to set `lora_rank > 0`.

# Create an instance of `vllm.Model` from `config`.
model = Model.from_config(config)

# Run inference.
transformer_output = model.forward(input_batch)[0]
```

### Decode output from model


```python
translation = tokenizer.decode(
    transformer_output['generated_ids'].cpu().numpy().tolist(),
    skip_special_tokens=True,
    clean_up_tokenization_spaces=True,
)
print(translation)
```

