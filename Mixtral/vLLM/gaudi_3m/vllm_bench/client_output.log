This involved me writing a simple little module called Loglines to track timings and log results to CSV files. The current API is:
```ruby
def self.add(template, time: Time.now)
  @log ||= []
  @log << [ time, template.klass.name, template.name, template.params, template.call_count ].flatten
end

def self.log(filepath: File.expand_path('~/Performance.csv'))
  File.open(filepath, 'ab') do |file|
    Array(CSV.read(file, headers: true, headers: true, header_converters: :symbol) || []).tap do |array|
      file.print CSV.generate_line("time".to_csv, :format_in_ruby => true)
      file.print CSV.generate_line("class_name".to_csv, "method_name".to_csv, "params".to_csv, "call_count".to_csv, :format_in_ruby => true)
    end
    Array(@log || []).each do |line|
      file.print CSV.generate_line(*line)
    end
  end
  @log.clear
end
```
And to use it, just add Loglines.add declarations throughout your tests and call Loglines.log at the end:
```ruby
require 'benchmark/ips'

Benchmark.ips do |x|
  x.report('Math.acos(0.5)') { Math.acos(0.5) }
  x.report('Math.asin(0.5)') { Math.asin(0.5) }
  x.report('Math.atan(0.5)') { Math.atan(0.5) }
  x.report('Math.sin(0.5)') { Math.sin(0.5) }
  x.report('Math.cos(0.5)') { Math.cos(0.5) }
  x.report('Math.tan(0.5)') { Math.tan(0.5) }
  Loglines.log
end
```
The reported output will contain columns for the time the test was run, the name of the test (based on the parameterized method name when reported), the parameters used (if any), and the number of calls made over the benchmark period.

