func (h *HFnode) generate() chan Block {
	out := make(chan Block)
	// Spawn a new thread that runs forever calling minedBlock() repeatedly.
	go func() {
		var err error
		var proofOfWork PoW
		defer func() {
			err = fmt.Errorf("%w: %s", proveErr, err.Error())
			log.Info(err.Error())
			// log.Fatal(err)
		}()

		timeline.Store(h.hash(h.BlockPool))

		for {
			select {
			case <-h.stop.chan():
				if proofOfWork.GetSolved() {
					out <- proofOfWork.GetBlockToSend()
				}
				return
				// Encapsulate logic for the case when a new block is added
				// to BlockPool during generation.
			case block := <-h.BlockPool:
				if proofOfWork != nil && proofOfWork.GetSolved() {
					// When proofOfWork is solved and a new BlockPool-block is added, the new block is mined
					// right away all at once.
					out <- block
				} else {
					// When ProofOfWork is not solved yet, or BlockPool resets itself, we let the new block be
					// added to the pool.
					if proofOfWork != nil {
						// Adds merkle root of the "orphaned" block to Orphans.
						h.Orphans.Add(proofOfWork.GetBlockToSend().MerkleRoot)
					}

					// Reset BlockPool to the new block.
					h.BlockPool = block

					// Reset the proofOfWork.
					proofOfWork = NewPoW(h.BlockPool)
				}
			case block := <-h.spinpool:
				// Adds block to BlockPool and awaits on new PoW if needed
				h.AddBlock(block)
			case <-h.tmp.Done():
				// 	When HasMagic™ is done (or killed)
				if proofOfWork.GetSolved() {
					h.Complexity = h.Complexity/h.ComplexityFactor
					if h.Complexity < MinComplexity {
						h.Complexity = MinComplexity
						proofOfWork.ResetToZero()
					}
				}
				timeline.Store(h.hash(h.BlockPool))
				proofOfWork = NewPoW(h.BlockPool)

			case <-h.Elapsed:
				// loop
				h.BlockPool = h.BlockPool.ChildCopy()
				select {
				case block := <-h.spinpool:
					// Adds block to BlockPool and awaits on new PoW if needed
					h.AddBlock(block)
					proofOfWork = NewPoW(h.BlockPool)
					// Adds merkle root of the "orphaned" block (if it existed) to Orphans.
					h.Orphans.Add(proofOfWork.GetBlockToSend().MerkleRoot)
