Benchmarking metal with different model precisions requires a small modification to the
script you used in the previous recipe. The
[training scripts](https://github.com/MalongTechnologies/metal/tree/v0.4.0/python_script/scripts) in
the repo do **not** change the model structure when you switch between different bitwidths.

The following example code shows how to benchmark the Alexnet model with 16-bit precision on
the `nvidia-smi` profiling platform. Other platforms (i.e., `oclc`) have similar interfaces.

```python
import tokenization
import transformers
from metal import Config, Sandbox

# instantiate a new Sandbox
sandbox = Sandbox()

# specify model configuration
model_config = transformers.AlexNetConfig()

# specify a new model config with a parameter setting of
# model_mode=3 and model_bitwidth=16
model_dfg_config = Config(
    {
        "model_bitwidth": 16,
        "model_mode": 3,
    },
    baseline=model_config,
)

# load the newly created dfg config
sandbox.model_framework.set_model(model_dfg_config)

# specify input data
tokenizer = tokenization.BertTokenizer.from_pretrained(
    "alexnet_postprocessed_vocab.txt", do_lower_case=True
)
train_instance, val_instance = sandbox.get_input_data(
    data_dir="data", token_data="data/sentence_pos_max_tokenized.txt", tokenizer=tokenizer
)

# specify optimizer/learning rate setting
optimizer_settings = {
    "definition": [
        ([{"name": "bias", "group": "group1", "lr": 0.0465}], "SGD"),
        ([{"name": "weight", "group": "group1", "lr": 0.0323}], "SGD"),
    ],
    "enable_learning_rate_decay": False,
}

# compile the model
sandbox.model_framework.compile(
    {
        "training_steps": 15,
        "training_warmup": 15,
        "batch_size": 256,
        "gradient_accumulation_steps": 1,
        "optimizer_settings": optimizer_settings,
        "log_graph": False,
    }
)

# before running the benchmarking, you must figure out
# the number of GPU units you have in your system.
import os

gpus = len(os.environ["CUDA_VISIBLE_DEVICES"].split(","))

# the num_repeats variable should be a **small**
# number, like 2 or 3, providing stable and useful results
num_repeats = 2

# Now, you can profile the device by setting nvidia-smi
# as platform and running the benchmarking procedure
platform_name = "nvidia-smi"

# benchmark the entire model
microbench_settings = {
    "profiling_engine": platform_name,
    "num_repeats": num_repeats,
}

sandbox.model_framework.benchmark(
    microbench_settings,
    ColdStart=True,
    PerCoreActivate=True,
    PerCorePrecision="fp32",
    GlobalActivate=True,
    Group=gpus,
    BWAlloc="fitto1500Mbps",
)
sandbox.model_framework.start_benchmark()

# report the result
import numpy as np

_ = [sandbox.model_framework.report(i) for i in range(len(microbench_settings["num_repeats"]))]

throughput = sandbox.model_framework.get_average_throughput()
overall_time = sandbox.model_framework.get_overall_time()

