PreProcess Method: Default
`` responses": [    {        "text": "1 2 trois 4 five six",        "start_index": 0,        "segments": [            {                "text": "1 2",                "phones": [                    {                        "phone_id": "SIL",                        "dur": "0", "bw": 0.047604543,         "F0": 131.09803}                    ],                    "accent_id": 0,                    "phoneme_length": null                  },...
