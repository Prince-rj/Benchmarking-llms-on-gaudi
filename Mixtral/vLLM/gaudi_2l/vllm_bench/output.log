See also <https://github.com/Helsinki-NLP/tweet-eval > available functional which is similar to the one provided in Hugging Face, but it's capabilities are focused on classification (regression) task. It may allow better fine-grained evaluation for downstream models if you could fit them into one of the tasks described there. Don't think it's capable of comparing with pre-trained models like BERT and ELECTRA though.
[149/200] Running: How to parse streaming responses from vLLM?...

🧠 LLM Response:

============================================

Here is a simple example of how to parse streaming responses with OwlReady:

```
import asyncio
from owlready2 import *

async def print_stream(f):
    async for line in f:
        print(' >', line.strip())

# Load some ontology
async def go():
    await World.load(...)
    my_ontology = ...

    # Get the streaming endpoint
    resp = requests.head(f'https://example.com/stream/{my_ontology.iri}')
    stream = resp.iter_content()

    # Parse the stream with Owlready
    async with AsyncStubber(ContentHandler) as handler:
        await asyncio.gather(
            handler.parse_read_async(stream),
            print_stream(handler.out),
            )

# Launch
asyncio.run(go())
```

This will print to the console the raw stream as sent by the vLLM server. It
does not record the stream, nor does it convert it to RDF/XML nodes. To do
so, you will need to subclass `ContentHandler`:

```
from owlready2 import *

class BufferedContentHandler(ContentHandler):
    def __init__(self):
        super().__init__()
        self.document = None
        self.individuals = []

    def startElement(self, name, attrs):
        if self.document is not None:
            if 'rdf' in name:
                super().startElement(name, attrs)
            else:
                return  # Skip
        else:
            if name == 'rdf:RDF':
                rid = attrs['xml:base'].rsplit('/', 1)[-1]
                self.document = get_Namespace(attrs['xml:base'])
            else:
                # Otherwise, nothing.
                pass

    def endElement(self, name):
        if self.document is not None:
            if name == 'rdf:RDF':
                # Prepare buffered content.
                ontology = self.document
                doc = Import(Ontology(ontology.iri), src='stream').asyncload()

                # Save
                async for node in doc:
                    print(node)

                # Check
                await World.asyncload()
                print(exists(Individual(document)))  # should print True.

                # Reset
                self.individuals.clear()
                self.document = None
            elif name == 'rdf:Description':
                # If it is an `rdf:Description`, registers and creates an
                # object in case it should be identified by an ontology.
                individual = Individual(self.document[self.object.split('#')[-1]])
                individual.set_properties_from_stream(self.attributes)
                self.individuals.append(individual)
            else:  # nothing
                pass

        else:
            # Otherwise, nothing.
            pass

    def characters(self, content):
        super().characters(content)

async def go():
    # ...
    await handler.parse_read_async(stream)
```

In this last example, the output will be registered as a properly recognized
individual of the ontology.
