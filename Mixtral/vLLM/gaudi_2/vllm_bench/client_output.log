            --tool=onnxruntime \
            --data-path=path/to/yolov5/data \
            --batch-size=16 \
            --epochs=100 \
            --imgsz=640 \
            --save-period=10 \
            --cfg="yolov5s.yaml" \
            --neptune \
            --feats \
            --precision=16 \
            --amax=100 \
            --verbose

    Use `--precision_list=fp32,fp16,bf16` to benchmark with multiple different precisions, it runs multiple times:

    .. code-block:: bash

        ./benchmarks/onnxruntime/trainval_neptune.sh \
            --tool=onnxruntime \
            --data-path=path/to/yolov5/data \
            --batch-size=16 \
            --epochs=100 \
            --imgsz=640 \
            --save-period=10 \
            --cfg="yolov5s.yaml" \
            --neptune \
            --feats \
            --precision_list=fp32,fp16,bf16 \
            --amax=100 \
            --verbose

