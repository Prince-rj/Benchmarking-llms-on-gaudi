    def pytorch_to_onnx(model, tokenizer, target_model_path, encoder_max_length, decoder_max_length, input_name, model_type, device='cuda'):
        """
        converting pytorch mmdectection model to onnx model
        """
        if 'fp16' in str(device):
            sanitize_dtype = torch.float16
        else:
            sanitize_dtype = torch.float32

        model.eval()
        model = model.half().to(device)
        input_texts = ['hello everyone it is great to be here', '', 'Bye folks!']
