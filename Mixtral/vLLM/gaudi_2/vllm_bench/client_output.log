```
struct Packet {
    data: vec<u8>,
}

impl Packet {
    fn decode(frame: &Frame) -> Self {
        let content = frame.content;

        let mut packet = Packet::new();
        let mut iter = content.into_iter();
        packet.data = iter
            .map(|c| c.unwrap().0 as u8)
            .collect::<Vec<u8>>();

        packet
