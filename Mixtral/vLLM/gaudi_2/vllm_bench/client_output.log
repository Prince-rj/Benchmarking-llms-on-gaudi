Basically, the code looks something like this:

```
const userMessage = await interaction.fieldTextways[index].awaitInput();

const userMessageData = generate(userMessage.trim());
if (userMessageData.stderr) {
  await sendEmbed(interaction, { title: "Error", description: userMessageData.stderr });
  return;
}

const userMessageFull = userMessageData.string.trim();
if (!userMessageFull) return await sendEmbed(interaction, { title: "Something happend.", color: "error" });

const userMessageEntries = parseMessage(userMessageFull);
if (!userMessageEntries.length) return await sendEmbed(interaction, { title: "Something happend.", color: "error" });

let newMessages = "";
for (let x = 0; x < interaction.message._layers[2]._items.length; x++) {
  if (x < userMessages.length) {
    if ((userMessages[x].isResponding && userMessages[x]._text.length > userMessages[x].responseTimeout) || x >= userMessages.length - 1) {
      userMessages[x].childPrompt = `_Continue the response below after ${herringbone.execution.dialogueData.responseDelay} seconds._\n\n`;
      while (userMessages[x].childPrompt && (userMessages[x].childPrompt.length > herringbone.execution.dialogueData.service.model.configuration.maxResponseLength || (getTotalLines(userMessages[x].childPrompt).length > herringbone.execution.dialogueData.service.model.configuration.maxLines)))) {
        userMessages[x].childPrompt = userMessages[x].childPrompt.substring(0, herringbone.execution.dialogueData.service.model.configuration.maxResponseLength);
        await herringbone.execution.runDialogue({}, "advanced");
      }
      if (getTotalLines(userMessages[x].childPrompt + userMessages[x + 1].prompt) > herringbone.execution.dialogueData.service.model.configuration.maxLines) {
        await herringbone.execution.runDialogue({}, "advanced");
        return await sendEmbed(interaction, { title: " Too much for me to handle.", color: "error" });
      }
      if (userMessages[x + 1].prompt && userMessages[x + 1].prompt.length > herringbone.execution.dialogueData.service.model.configuration.maxResponseLength) {
        userMessages[x + 1].prompt = userMessages[x + 1].prompt.substring(0, herringbone.execution.dialogueData.service.model.configuration.maxResponseLength);
        await herringbone.execution.runDialogue({}, "advanced");
      }
      newMessages += userMessages[x].childPrompt;
    } else {
      newMessages += userMessages[x].prompt;
    }
  } else {
    newMessages += herringbone.execution.dialogueData.service.model.generate(userMessageEntries[x]);
  }
}

App.updateDialogue(interaction, newMessages);
await sendEmbed(interaction);
