&= \log\frac{1/(1+e^{-z})}{1-1/(1+e^{-z})} \\
&= \log\frac{1/(1+e^{-z})}{e^{-z}/(1+e^{-z})} \\
&= \log e^{z} \\
&= z
\end{align}
$$

