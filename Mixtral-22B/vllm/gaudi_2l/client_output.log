              (.set-long (.-max-length c) (* 2 tokens-to-generate))
              (.set-long (.-n-compute-tokens c) (* 2 tokens-to-generate))
              (.set-bool (.-mean-only c) forward-only)
              (.applyTo generator result c %]))
        (doall
          (for [_ [(range len) :multi :length l]
                ^clojure.lang.IFn g (get generator :generate)]
            (let [^clojure.lang.IFn c generator]
              (-> generator
                  (.set-int (.-max-new-tokens c) tokens-to-generate)
                  (.set-long (.-max-length c) (* 2 tokens-to-generate))
                  (.set-long (.-n-compute-tokens c) (* 2 tokens-to-generate))
                  (.applyTo generator g)))))))
    (let [^Boolean log-output (get params :log-output)]
