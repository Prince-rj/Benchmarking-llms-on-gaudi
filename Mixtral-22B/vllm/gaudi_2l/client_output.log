# 一開始先做 initialize 例如數值化之類的，也會產生一claimed_links 的列表Example:
def _decode_raw(
    self,
    token_ids: th.LongTensor,
    oracle_mask: th.BoolTensor,
    cross_encode_step: Optional[bool] = False,
) -> th.FloatTensor:

    with th.no_grad():
        token_emb = self.hf_model.hf_model.wte(token_ids)

        if self.model_config.add_image_bert:
             # TODO NEED TO MERGE WHEN WE SUPPORT IMAGE
             # raise ValueError("Image not support for HF")

             # GENERATE EXTRA EMBEDDING FOR IMAGE IF AVAIBALE AND THUS CAUSING FEAREISSUE??
            if cross_encode_step:
                predicted_emb = self.image_model.encode_images_encode_step(self.images)
            else:
                prediction_emb_list = []
                for image in self.images:
                    prediction_emb_list.append(self.image_model(image, steps=self.image_prediction_max_steps))
                predicted_emb = th.stack(prediction_emb_list)
            # predicted_embedding shape: (batch_size, image_seq_length, image_emb_dims)
            predicted_emb = predicted_emb.transpose(1, 2)

            token_emb = th.cat((token_emb, predicted_emb), dim=2)

        # shape: NumClip * longest_sentence_length * dims
        encoder_outputs = self.encode(token_emb)

        # get softmax scores for each token id
        # shape: NumClip * longest_sentence_length * vocab_size
        logits = (token_emb + encoder_outputs) @ self.model_config.lm_head.weight.t()[None, None, :]

        # remove padding so that the scores can be correctly created for keys
        if not cross_encode_step:
            log_probs = F.log_softmax(logits, dim=-1)
            # remove last token from log probs
            log_probs = log_probs[:, :-1]

            # remove pad tokens for ground truth/oracle score
            # remove CLS and SEP
            probabilites = log_probs.gather(-1, token_ids[:, 1:-1].unsqueeze(-1)).squeeze(-1)

        else:
            logits = logits[:, 1:-1, :]

            # remove CLS and SEP
            keys = token_ids[:, 1:-1].clone()

            # shape: batch_size, num of atoms, num_pred_heads
            logits = self._predict_softmax(token_ids)
            logits = logits[:, 1:, :]  # Remove class token prob
            log_probs = F.log_softmax(logits, -1)
            probabilities = log_probs.gather(-1, keys.unsqueeze(
                -1)).squeeze(-1)
            probabilities *= oracle_mask.float()

        return probabilities.type(th.float32)
```

